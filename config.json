    "general": {
      "input_tokens": 5000,
      "output_tokens": 1200,
      "weight": 0.1
    }
  },
  "paid_min_quality": {
    "coding": 8.6,
    "agentic": 8.7,
    "reasoning": 8.7,
    "general": 8.4
