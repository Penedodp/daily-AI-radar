{
  "timezone": "Europe/Lisbon",
  "report_language": "es",
  "summary_model": "openrouter/free",
  "max_models_in_ai_summary": 25,
  "discount_threshold_pct": 10,
  "price_increase_threshold_pct": 10,
  "cross_provider_min_saving_pct": 5,
  "value_cost_anchor_usd": 0.05,
  "route_tracking_max_models": 35,
  "providers": {
    "openrouter": {
      "enabled": true
    },
    "cheaperinference": {
      "enabled": true,
      "optional": true
    },
    "together": {
      "enabled": true,
      "optional": true
    },
    "novita": {
      "enabled": true,
      "optional": true
    },
    "openrouter_routes": {
      "enabled": true,
      "optional": true
    }
  },
