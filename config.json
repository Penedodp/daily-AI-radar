      "(^|[/_-])embed($|[/_:-])",
      "rerank",
      "lyria",
      "whisper",
      "transcri",
      "text[-_ ]?to[-_ ]?speech",
      "(^|[/_-])tts($|[/_:-])",
      "seedream",
      "sora",
      "(^|[/_-])veo($|[/_:-])",
      "gpt[-_ ]?image",
